LangString INSTALLER_EXTRACT_COPY 3082 "Copiar detalles del error"
LangString INSTALLER_EXTRACT_EXPAND ${LANG_ENGLISH} "Show details"
LangString INSTALLER_EXTRACT_EXPAND 3082 "Mostrar detalles"
